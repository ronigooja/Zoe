# Copy to /etc/zoe/zoe-stack.env and set deployment-specific values.
# Secret variables below are file references, never secret contents.
# Published by server-release.yml. Replace the placeholders with the reviewed
# `digest` values from release-manifest.json; deploy by digest, not by a tag.
ZOE_SERVER_IMAGE=ghcr.io/ronigooja/zoe-server@sha256:SERVER_IMAGE_DIGEST
ZOE_MEMORY_WORKER_IMAGE=ghcr.io/ronigooja/zoe-memory-worker@sha256:MEMORY_IMAGE_DIGEST
ZOE_SERVER_PORT=8787
ZOE_SERVER_DATA_ROOT=/var/lib/zoe/server
ZOE_MEMORY_DATA_ROOT=/var/lib/zoe/memory
ZOE_RUNNER_TOKEN_FILE=/etc/zoe/secrets/runner-token
ZOE_MAX_RUNS=12
ZOE_MEMORY_RUNNER_TOKEN_FILE=/etc/zoe/secrets/memory-runner-token
ZOE_MEM0_LLM_API_KEY_FILE=/etc/zoe/secrets/mem0-llm-api-key
ZOE_RUNTIME_PROFILES={"worker":{"id":"worker","harness":"opencode","runtime_route_id":"opencode","model_route_id":"default","role":"worker","isolation_policy":"opencode-workspace-write-v1","capability_ids":[],"scopes":[]}}
ZOE_DEFAULT_PROFILE_ID=worker
ZOE_MEM0_LLM_MODEL=deployment-selected-model
ZOE_MEM0_LLM_REASONING_EFFORT=
ZOE_MEM0_LLM_BASE_URL=https://deployment-provided-existing-gateway.example.invalid/v1
# Context register for delegated voice sentences.
# Register settings fall back to Steward when unset; its timeout defaults to 30000 ms.
# Old deployed ZOE_TRIAGE_* host entries are unused and do not break startup.
# ZOE_REGISTER_BASE_URL=https://deployment-provided-existing-gateway.example.invalid
# ZOE_REGISTER_MODEL=deployment-selected-register-model
# ZOE_REGISTER_REASONING_EFFORT=
# ZOE_REGISTER_TIMEOUT_MS=30000
# ZOE_REGISTER_API_KEY_FILE=/etc/zoe/secrets/register-api-key
# When recall is enabled, customize the holding sentence.
# ZOE_RECALL_HOLDING_TEXT=I will check our earlier conversations.

# Stateless task manager; an empty base URL fails task routing closed.
# ZOE_STEWARD_BASE_URL=https://deployment-provided-existing-gateway.example.invalid
# Call-start delegation instruction: empty uses built-in default; literal off disables.
# ZOE_VOICE_INSTRUCTION_TEXT=
# ZOE_STEWARD_MODEL=deployment-selected-steward-model
# ZOE_STEWARD_API_STYLE=
# ZOE_STEWARD_REASONING_EFFORT=none
# ZOE_STEWARD_THINKING=disabled
# ZOE_STEWARD_TIMEOUT_MS=2000
# ZOE_STEWARD_API_KEY_FILE=/etc/zoe/secrets/steward-api-key

# Optional memory and conversation answer endpoint. An empty base URL disables it.
# ZOE_ANSWER_BASE_URL=https://deployment-provided-existing-gateway.example.invalid/v1
# ZOE_ANSWER_MODEL=deployment-selected-answer-model
# ZOE_ANSWER_REASONING_EFFORT=
# ZOE_ANSWER_THINKING=
# ZOE_ANSWER_API_KEY_FILE=/etc/zoe/secrets/answer-api-key
# ZOE_ANSWER_TIMEOUT_MS=8000

# Capability service execution is disabled by default. To enable the Docker
# executor, configure a deployment-owned capability registry and explicitly
# grant the runner capability:deploy in ZOE_RUNNER_SCOPES. Never add that
# scope to an existing runner credential without a deliberate credential
# rotation/re-registration procedure.
# ZOE_CAPABILITY_RUNTIME_BACKEND=docker
# ZOE_AVAILABLE_CAPABILITY_IDS=mail.read,calendar.read
# ZOE_RUNNER_SCOPES=runner:claim,runner:observe,runner:control:read,capability:deploy

# Configure only when a compatible HTTPS voice gateway is separately provisioned.
# The gateway must be the Zoe-compatible fork/release documented in
# deploy/voice/README.md; the stock upstream API is not sufficient.
# ZOE_VOICE_GATEWAY_URL=https://voice.example.internal
# ZOE_VOICE_GATEWAY_API_KEY_FILE=/etc/zoe/secrets/voice-gateway-api-key
# Optional independent gateway-to-Zoe transcript credential (disabled by default).
# ZOE_VOICE_INGEST_TOKEN_FILE=/etc/zoe/secrets/voice-ingest-token
# ZOE_VOICE_INGEST_ID=voice-gateway
# ZOE_VOICE_INGEST_WORKSPACES=default
# Supply the key through a mode-0600 deployment secret file; never commit the
# key or place it in this example. `zoe voice configure` manages these values.
# The selected chatgpt-web-voice gateway already owns account-pool selection
# and sticky-session behavior. The current baseline accepts client-direct
# WebRTC media, so this separate Zoe lease adapter cannot prove upstream media
# termination and must stay disabled. `true` is unsupported until a future
# gateway-terminated/relayed media design supplies and passes the complete
# account-lease identity and exact idempotent release contract.
# ZOE_VOICE_ACCOUNT_MEDIA_ENABLED=false
