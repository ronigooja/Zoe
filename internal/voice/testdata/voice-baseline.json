    "tasks": [
      "table",
      "tasks",
      "tasks",
      "CREATE TABLE tasks ( id TEXT PRIMARY KEY, project_id TEXT, title TEXT NOT NULL, goal TEXT NOT NULL, source TEXT NOT NULL, profile_id TEXT NOT NULL, status TEXT NOT NULL CHECK(status IN ('queued','active','waiting','awaiting_user','paused','complete','failed','canceled')), version INTEGER NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, accepted_at TEXT, started_at TEXT, finished_at TEXT, result TEXT NOT NULL DEFAULT '', error TEXT NOT NULL DEFAULT '', created_by_device_id TEXT NOT NULL REFERENCES actors(id), command_id TEXT NOT NULL, owner_subject_id TEXT NOT NULL DEFAULT '', lineage_root_task_id TEXT REFERENCES tasks(id), lineage_parent_task_id TEXT REFERENCES tasks(id), lineage_depth INTEGER NOT NULL DEFAULT 0, child_policy_json BLOB NOT NULL DEFAULT '', root_child_limit INTEGER NOT NULL DEFAULT 0, pregrant_capabilities_json BLOB NOT NULL DEFAULT '[]', harness TEXT NOT NULL DEFAULT 'codex', interaction_state TEXT NOT NULL DEFAULT 'none' CHECK(interaction_state IN ('none','awaiting_message','explicit_confirmation','approval_required')), interaction_scope TEXT NOT NULL DEFAULT '', interaction_run_id TEXT NOT NULL DEFAULT '', interaction_action_digest TEXT NOT NULL DEFAULT '', interaction_expires_at TEXT, interaction_expected_version INTEGER NOT NULL DEFAULT 0, interaction_question TEXT NOT NULL DEFAULT '', interaction_expired_kind TEXT NOT NULL DEFAULT '', ui_display INTEGER NOT NULL DEFAULT 0 CHECK(ui_display IN (0,1)), FOREIGN KEY(project_id) REFERENCES projects(id) )"
    ],
